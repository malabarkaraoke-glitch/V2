section("TELE",function()
	local P=addTab("Tele","TELEPORT")
	local selected=nil
	local mode="normal"
	local stickConn=nil
	local autoAtk=false
	local itemBtns={}

	local selLbl=P.info("Target: belum dipilih",24)
	local list=P.container()
	local modeRow=P.row(30)
	P.rowLabel(modeRow,"Mode")
	local modeBtn=P.rowButton(modeRow,"BIASA",110)
	local goBtn=P.button("TELEPORT",nil,Color3.fromRGB(150,80,20))
	P.toggle("autoAtk","AUTO SERANG",false,function(on) autoAtk=on end)

	local function updateGoText()
		if mode=="normal" then
			goBtn.Text="TELEPORT"
			goBtn.BackgroundColor3=Color3.fromRGB(150,80,20)
		elseif stickConn then
			goBtn.Text="BERHENTI NEMPEL"
			goBtn.BackgroundColor3=Color3.fromRGB(170,50,30)
		else
			goBtn.Text="MULAI NEMPEL"
			goBtn.BackgroundColor3=Color3.fromRGB(120,80,160)
		end
	end
	local function stopStick()
		if stickConn then stickConn:Disconnect(); stickConn=nil end
		updateGoText()
	end
	local function highlight()
		for pl,b in pairs(itemBtns) do
			local on=(pl==selected)
			b.BackgroundColor3=on and ACC or ROW
			b.TextColor3=on and BLACK or TXT
		end
		selLbl.Text=selected and ("Target: "..selected.DisplayName) or "Target: belum dipilih"
	end
	local function refreshList()
		for _,c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		itemBtns={}
		if selected and not selected.Parent then selected=nil; stopStick() end
		for _,pl in ipairs(Players:GetPlayers()) do
			if pl~=lp then
				local b=new("TextButton",{
					Size=UDim2.new(1,0,0,26),BackgroundColor3=ROW,Font=FONT,
					Text=pl.DisplayName.." (@"..pl.Name..")",TextColor3=TXT,TextSize=12,
					TextTruncate=Enum.TextTruncate.AtEnd,AutoButtonColor=false,
				},list)
				corner(b,6)
				b.MouseButton1Click:Connect(function()
					selected=pl
					highlight()
				end)
				itemBtns[pl]=b
			end
		end
		highlight()
	end
	onPlayers(refreshList)

	modeBtn.MouseButton1Click:Connect(function()
		stopStick()
		mode=(mode=="normal") and "nempel" or "normal"
		modeBtn.Text=(mode=="normal") and "BIASA" or "NEMPEL"
		updateGoText()
	end)

	goBtn.MouseButton1Click:Connect(function()
		if not selected or not selected.Parent then
			notify("Pilih target","Tap nama pemain di daftar dulu")
			return
		end
		if mode=="normal" then
			local my,r=getHRP(lp),getHRP(selected)
			if my and r then
				my.CFrame=r.CFrame*CFrame.new(0,0,3)
			else
				notify("Gagal","Karakter target belum ada")
			end
		else
			if stickConn then stopStick() return end
			stickConn=RunService.Heartbeat:Connect(function()
				if not selected or not selected.Parent then stopStick() return end
				local my,r=getHRP(lp),getHRP(selected)
				if not my or not r then return end
				my.CFrame=CFrame.new(r.Position-r.CFrame.LookVector*3,r.Position)
				if autoAtk then fireTool(r) end
			end)
			updateGoText()
		end
	end)
end)

