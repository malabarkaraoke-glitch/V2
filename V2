-- ===================== CONFIG (SIMPAN) =====================
local CFG_FILE="GodPanel_Config.json"
local saved={}
do
	local ok,data=pcall(function()
		if isfile and readfile and isfile(CFG_FILE) then
			return HttpService:JSONDecode(readfile(CFG_FILE))
		end
	end)
	if ok and type(data)=="table" then
		saved=data
	elseif type(G.GodConfig)=="table" then
		saved=G.GodConfig
	end
end

local loading=true
local controls={}
local saveQueued=false
local autoSave=(saved._autosave~=false)

local function saveNow()
	local t={_autosave=autoSave}
	if autoSave then
		for k,c in pairs(controls) do t[k]=c.get() end
	end
	G.GodConfig=t
	pcall(function()
		if writefile then writefile(CFG_FILE,HttpService:JSONEncode(t)) end
	end)
end
local function queueSave()
	if loading or saveQueued or not autoSave then return end
	saveQueued=true
	task.delay(0.5,function()
		saveQueued=false
		saveNow()
	end)
end

