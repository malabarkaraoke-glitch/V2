local playerListeners={}
local knownPlayers={}
local function playersChanged()
	local changed=false
	local cur={}
	for _,pl in ipairs(Players:GetPlayers()) do
		cur[pl]=true
		if not knownPlayers[pl] then changed=true end
	end
	for pl in pairs(knownPlayers) do
		if not cur[pl] then changed=true end
	end
	knownPlayers=cur
	return changed
end
local function firePlayers()
	for _,fn in ipairs(playerListeners) do pcall(fn) end
end
local function onPlayers(fn)
	table.insert(playerListeners,fn)
	pcall(fn)
end
