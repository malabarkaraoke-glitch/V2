section("SPEED",function()
	local P=addTab("Speed","SPEED")
	local speedPct=100
	local baseSpeed=16
	do
		local c=lp.Character
		local h=c and c:FindFirstChildOfClass("Humanoid")
		if h then baseSpeed=h.WalkSpeed end
	end

	local speedLbl=P.info("Kecepatan: 100%",24)
	local stepRow=P.row(30)
	P.rowLabel(stepRow,"Tambah/tap (%)")
	local stepBox=new("TextBox",{
		BackgroundColor3=OFFBG,Position=UDim2.new(1,-66,0.5,-11),Size=UDim2.new(0,60,0,22),
		Font=FONT,Text="1",PlaceholderText="1",ClearTextOnFocus=false,
		TextColor3=TXT,TextSize=13,
	},stepRow)
	corner(stepBox,5)
	local pmRow=P.row(34)
	local slowBtn=new("TextButton",{
		BackgroundColor3=SIDE2,Position=UDim2.new(0,6,0.5,-12),Size=UDim2.new(0.5,-9,0,24),
		Font=FONTB,Text="-",TextColor3=TXT,TextSize=20,AutoButtonColor=true,
	},pmRow)
	corner(slowBtn,5)
	local fastBtn=new("TextButton",{
		BackgroundColor3=ACC,Position=UDim2.new(0.5,3,0.5,-12),Size=UDim2.new(0.5,-9,0,24),
		Font=FONTB,Text="+",TextColor3=BLACK,TextSize=20,AutoButtonColor=true,
	},pmRow)
	corner(fastBtn,5)

	local function getStep()
		local v=tonumber(stepBox.Text)
		if not v or v<=0 then return 1 end
		return math.clamp(v,0.1,100)
	end
	stepBox.FocusLost:Connect(function() stepBox.Text=tostring(getStep()) end)

	local function fmt(n) return tostring(math.floor(n*10+0.5)/10) end
	local function updateLbl()
		speedLbl.Text=string.format("Kecepatan: %s%% (%.1f)",fmt(speedPct),baseSpeed*speedPct/100)
	end
	local function applySpeed()
		local char=lp.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed=baseSpeed*speedPct/100 end
	end
	local function setPct(v,quiet)
		speedPct=math.clamp(tonumber(v) or 100,10,1000)
		updateLbl()
		applySpeed()
		if not quiet then queueSave() end
	end
	local function changeSpeed(delta,quiet) setPct(speedPct+delta,quiet) end
	updateLbl()

	local function holdRepeat(btn,sign)
		local gen=0
		local held=false
		local function release()
			if held then
				held=false
				gen=gen+1
				queueSave()   -- simpan sekali saat dilepas, bukan tiap langkah (file tertulis terus = patah-patah)
			end
		end
		btn.MouseButton1Down:Connect(function()
			held=true
			gen=gen+1
			local my=gen
			changeSpeed(sign*getStep(),true)
			task.delay(0.4,function()
				while gen==my do
					changeSpeed(sign*getStep(),true)
					task.wait(0.1)
				end
			end)
		end)
		btn.InputEnded:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1
			or i.UserInputType==Enum.UserInputType.Touch then
				release()
			end
		end)
		btn.MouseLeave:Connect(release)
	end
	holdRepeat(fastBtn,1)
	holdRepeat(slowBtn,-1)

	P.button("RESET KE NORMAL",function()
		setPct(100)
		notify("Kecepatan normal","Kembali ke kecepatan asli")
	end,Color3.fromRGB(150,80,20))

	controls.speed={
		default=100,
		get=function() return speedPct end,
		set=function(v) setPct(v) end,
	}

	-- WalkSpeed TIDAK dipaksa tiap frame (itu bentrok dengan script game dan bikin jalan patah-patah).
	-- Cukup diset saat persen berubah / karakter baru, dan dicek ulang pelan-pelan (1 detik).
	task.spawn(function()
		while main.Parent do
			task.wait(1)
			if speedPct~=100 then
				local char=lp.Character
				local hum=char and char:FindFirstChildOfClass("Humanoid")
				if hum then
					local target=baseSpeed*speedPct/100
					if math.abs(hum.WalkSpeed-target)>1 then hum.WalkSpeed=target end
				end
			end
		end
	end)

	local spHum=nil
	task.spawn(function()
		while main.Parent do
			task.wait(0.3)
			local c=lp.Character
			local h=c and c:FindFirstChildOfClass("Humanoid")
			if h and h~=spHum then
				spHum=h
				if speedPct==100 then
					baseSpeed=h.WalkSpeed
					updateLbl()
				else
					applySpeed()
				end
			end
		end
	end)
end)

-- =====================================================================
-- TAB AIM : SILENT AIM (otomatis survivor/killer) + PELACAK KENA
-- Tab dibuat di sini supaya urutan menu tetap. Isinya dibangun di bagian
-- paling bawah script, supaya error di AIM tidak menghentikan panel.
-- =====================================================================
local AimTab=addTab("Aim","SILENT AIM")

local function buildAim(P)
	local ST=G.GodAimST
	if not ST then ST={hooked=false}; G.GodAimST=ST end
	ST.gen=(ST.gen or 0)+1
	local gen=ST.gen
	ST.on=false
	ST.onToggle=false
	ST.aimHead=false
	ST.forceTouch=false
	ST.seen=ST.seen or {}
	ST.count=ST.count or 0
	ST.partSet=ST.partSet or {}
	ST.charSet=ST.charSet or {}
	ST.pending=ST.pending or {}
	ST.tally=ST.tally or {}      -- hasil tiap kecepatan peluru yang diuji: {h=kena, m=meleset}
	ST.targetPart,ST.targetChar,ST.targetPlr=nil,nil,nil
	ST.myPos=nil
	ST.role="SURVIVOR"
	if ST.predict==nil then ST.predict=true end
	if ST.filterShot==nil then ST.filterShot=true end

	local canHook=(hookmetamethod and newcclosure and getnamecallmethod and checkcaller) and true or false
	local MAX_LEAD=0.6
	local MAX_REMOTES=30
	local TOUCH_REACH=15
	local SHOT_TIMEOUT=1.2                              -- detik: lewat dari ini dihitung meleset
	local SPEEDS={60,90,120,160,220,300}                -- kecepatan peluru (stud/detik) yang diuji otomatis
	local KILLER_WORDS={"killer"}
	local SHOT_WORDS={
		"hit","attack","fire","shoot","shot","damage","gun","bullet","projectile","ray","aim",
		"stab","slash","swing","throw","spear","lempar","tombak","javelin","lance","harpoon",
		"melee","punch","release","launch","impale","cast","strike",
	}

	local function looksLikeShot(name)
		local l=string.lower(name)
		for _,w in ipairs(SHOT_WORDS) do
			if string.find(l,w,1,true) then return true end
		end
		return false
	end

	local function sigOf(n,args)
		local parts,hasDir={},false
		for i=1,math.min(n,6) do
			local v=args[i]
			local t=typeof(v)
			local s
			if t=="Vector3" then s="V3"; hasDir=true
			elseif t=="CFrame" then s="CF"; hasDir=true
			elseif t=="Instance" then
				if ST.partSet[v] or ST.charSet[v] then s="Musuh"; hasDir=true else s="Inst" end
			elseif t=="number" then s="Num"
			elseif t=="string" then s="Str"
			elseif t=="boolean" then s="Bool"
			elseif t=="table" then s="Tbl"
			else s=t end
			parts[#parts+1]=s
		end
		local s=table.concat(parts,",")
		if s=="" then s="-" end
		return s,hasDir
	end

	-- dada (UpperTorso) default; kepala kalau BIDIK KEPALA dinyalakan
	local function aimPart(ch)
		if ST.aimHead then
			local h=ch:FindFirstChild("Head")
			if h then return h end
		end
		return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
	end

	-- posisi bidik: prediksi gerak dengan waktu tempuh = jarak / kecepatan peluru
	local function aimPoint(part,speed)
		local pos=part.Position
		if ST.predict then
			local o=ST.myPos or pos
			local t=math.min((pos-o).Magnitude/(speed or 120),MAX_LEAD)
			local v=part.AssemblyLinearVelocity
			pos=pos+Vector3.new(v.X,0,v.Z)*t
		end
		return pos
	end

	-- pilih kecepatan peluru yang paling sering kena (sambil menguji yang belum cukup dicoba)
	local function pickSpeed()
		local best,bestScore=SPEEDS[1],-1
		for _,c in ipairs(SPEEDS) do
			local s=ST.tally[c] or {h=0,m=0}
			local n=s.h+s.m
			if n<3 then return c end
			local score=(s.h+1)/(n+2)
			if score>bestScore then best,bestScore=c,score end
		end
		return best
	end
	local function bestSpeedInfo()
		local best,bestScore,bh,bn=nil,-1,0,0
		for _,c in ipairs(SPEEDS) do
			local s=ST.tally[c]
			if s and s.h+s.m>0 then
				local score=(s.h+1)/(s.h+s.m+2)
				if score>bestScore then best,bestScore,bh,bn=c,score,s.h,s.h+s.m end
			end
		end
		return best,bh,bn
	end

	-- ubah 1 argumen supaya mengarah ke titik bidik
	local function fix(v,depth,pos,me)
		local t=typeof(v)
		if t=="Vector3" then
			local m=v.Magnitude
			if m>0.5 and m<1.5 then
				local d=pos-me
				if d.Magnitude>0.1 then return d.Unit,true end
			elseif (v-me).Magnitude>6 then
				return pos,true
			end
		elseif t=="CFrame" then
			local p=v.Position
			if (p-me).Magnitude<=6 then
				if (pos-p).Magnitude>0.1 then return CFrame.lookAt(p,pos),true end
			else
				return CFrame.new(pos)*(v-p),true
			end
		elseif t=="Instance" then
			if ST.partSet[v] and v~=ST.targetPart then return ST.targetPart,true end
			if ST.charSet[v] and v~=ST.targetChar then return ST.targetChar,true end
		elseif t=="table" and depth<1 then
			local copy,ch={},false
			for k,x in pairs(v) do
				local nx,c=fix(x,depth+1,pos,me)
				if c then copy[k]=nx; ch=true else copy[k]=x end
			end
			if ch then return copy,true end
		end
		return v,false
	end

	-- remote yang ON di screenshot = ON otomatis; remote lain OFF
	local REMOTE_ON={"updatecharacterlook","getping","spearstate","spearthrow","basicattack"}
	local function presetUse(name)
		local l=string.lower(name)
		for _,w in ipairs(REMOTE_ON) do
			if string.find(l,w,1,true) then return true end
		end
		return false
	end

	local function process(self,n,args)
		local name=self.Name
		if type(name)~="string" then return false end
		local rec=ST.seen[name]
		if not rec then
			if ST.filterShot and not looksLikeShot(name) then return false end
			if ST.count>=MAX_REMOTES then return false end
			ST.count=ST.count+1
			rec={n=0,mod=0,hit=0,sig="",hasDir=false,order=ST.count}
			ST.seen[name]=rec
		end
		rec.n=rec.n+1
		if rec.n<=3 or rec.sig=="" then
			local s,h=sigOf(n,args)
			rec.sig=s
			rec.hasDir=rec.hasDir or h
		end
		if rec.use==nil then rec.use=presetUse(name) end
		if not ST.on or not rec.use then return false end
		local tp=ST.targetPart
		if not (tp and tp.Parent) then return false end
		local spd=pickSpeed()
		local pos=aimPoint(tp,spd)
		local me=ST.myPos or pos
		local changed=false
		for i=1,n do
			local nv,c=fix(args[i],0,pos,me)
			if c then args[i]=nv; changed=true end
		end
		if changed then
			rec.mod=rec.mod+1
			local pl=ST.targetPlr
			local ch=pl and pl.Character
			local hum=ch and ch:FindFirstChildOfClass("Humanoid")
			if hum then
				table.insert(ST.pending,{rec=rec,hum=hum,hp=hum.Health,t=os.clock(),spd=spd})
			end
		end
		return changed
	end
	ST.proc=process

	-- hook dipasang HANYA saat SILENT AIM dinyalakan
	local function installHook()
		if ST.hooked then return true end
		if not canHook then return false end
		local ok=pcall(function()
			local old
			old=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
				local method=getnamecallmethod()
				if (method=="FireServer" or method=="InvokeServer") and not checkcaller() and ST.proc then
					local n=select("#",...)
					local args={...}
					local okp,changed=pcall(ST.proc,self,n,args)
					if setnamecallmethod then setnamecallmethod(method) end
					if okp and changed then
						return old(self,table.unpack(args,1,n))
					end
				end
				return old(self,...)
			end))
		end)
		ST.hooked=ok
		return ok
	end

	-- ===== peran & target =====
	local function teamHas(pl,words)
		local tn=pl.Team and string.lower(pl.Team.Name)
		if not tn then return false end
		for _,w in ipairs(words) do
			if string.find(tn,w,1,true) then return true end
		end
		return false
	end
	local function isAlive(pl)
		local c=pl.Character
		local h=c and c:FindFirstChildOfClass("Humanoid")
		return h~=nil and h.Health>0
	end
	-- survivor -> target killer; killer -> target survivor
	local function isEnemy(pl)
		if pl==lp or not isAlive(pl) or teamHas(pl,{"spectat"}) then return false end
		if teamHas(lp,KILLER_WORDS) then return not teamHas(pl,KILLER_WORDS) end
		return teamHas(pl,KILLER_WORDS)
	end

	-- pilih musuh yang paling dekat dengan TENGAH LAYAR; kalau tidak ada di layar, pilih yang terdekat
	local function updateTarget()
		local cam=workspace.CurrentCamera
		local me=lp.Character
		local head=me and (me:FindFirstChild("Head") or me:FindFirstChild("HumanoidRootPart"))
		local origin=head and head.Position or (cam and cam.CFrame.Position)
		ST.myPos=origin
		ST.role=teamHas(lp,KILLER_WORDS) and "KILLER" or "SURVIVOR"
		ST.on=ST.onToggle and true or false

		local center=Vector2.new(0,0)
		if cam then
			local vp=cam.ViewportSize
			center=Vector2.new(vp.X/2,vp.Y/2)
		end

		local partSet,charSet={},{}
		local bestPart,bestChar,bestPl,bestD,bestScore=nil,nil,nil,nil,math.huge
		for _,pl in ipairs(Players:GetPlayers()) do
			if isEnemy(pl) and pl.Character then
				local ch=pl.Character
				charSet[ch]=true
				for _,d in ipairs(ch:GetDescendants()) do
					if d:IsA("BasePart") then partSet[d]=true end
				end
				local part=aimPart(ch)
				if part and origin and cam then
					local d3=(part.Position-origin).Magnitude
					local sp,on=cam:WorldToViewportPoint(part.Position)
					local score
					if on and sp.Z>0 then
						score=(Vector2.new(sp.X,sp.Y)-center).Magnitude
					else
						score=100000+d3
					end
					if score<bestScore then
						bestPart,bestChar,bestPl,bestD,bestScore=part,ch,pl,d3,score
					end
				end
			end
		end
		ST.partSet,ST.charSet=partSet,charSet
		ST.targetPart,ST.targetChar,ST.targetPlr=bestPart,bestChar,bestPl
		ST.targetDist=bestD
	end

	-- ===== PELACAK KENA =====
	-- Tembakan dianggap KENA kalau darah target turun dalam SHOT_TIMEOUT detik.
	-- Dari hasil ini, kecepatan peluru yang paling akurat dipilih otomatis.
	local function resolveHit(p)
		p.rec.hit=(p.rec.hit or 0)+1
		local s=ST.tally[p.spd] or {h=0,m=0}
		s.h=s.h+1
		ST.tally[p.spd]=s
	end
	local function resolveMiss(p)
		local s=ST.tally[p.spd] or {h=0,m=0}
		s.m=s.m+1
		ST.tally[p.spd]=s
	end
	task.spawn(function()
		while main.Parent and ST.gen==gen do
			task.wait(0.03)
			local now=os.clock()
			local i=1
			while i<=#ST.pending do
				local p=ST.pending[i]
				if not p.hum.Parent then
					table.remove(ST.pending,i)
					resolveMiss(p)
				elseif p.hum.Health<p.hp then
					table.remove(ST.pending,i)
					resolveHit(p)
					for _,q in ipairs(ST.pending) do
						if q.hum==p.hum then q.hp=p.hum.Health end
					end
				elseif now-p.t>SHOT_TIMEOUT then
					table.remove(ST.pending,i)
					resolveMiss(p)
				else
					i=i+1
				end
			end
		end
	end)

	-- ===== PAKSA KENA (sentuhan, jarak dekat) =====
	task.spawn(function()
		while main.Parent and ST.gen==gen do
			task.wait(0.05)
			if ST.on and ST.forceTouch and firetouchinterest and ST.targetPart and ST.targetPart.Parent
			and (ST.targetDist or math.huge)<=TOUCH_REACH then
				local ch=lp.Character
				local tool=ch and ch:FindFirstChildOfClass("Tool")
				local handle=tool and tool:FindFirstChild("Handle")
				if handle then
					pcall(function()
						firetouchinterest(ST.targetPart,handle,0)
						firetouchinterest(ST.targetPart,handle,1)
					end)
				end
			end
		end
	end)

	-- ===== daftar remote =====
	local rowBtns={}
	local listBox=P.container()
	local function refreshRows()
		for name,rec in pairs(ST.seen) do
			local b=rowBtns[name]
			if not b then
				b=new("TextButton",{
					Size=UDim2.new(1,0,0,24),Font=FONT,TextSize=11,LayoutOrder=rec.order,
					TextTruncate=Enum.TextTruncate.AtEnd,AutoButtonColor=false,
				},listBox)
				corner(b,6)
				b.MouseButton1Click:Connect(function()
					local r=ST.seen[name]
					if r then
						if r.use==nil then r.use=true else r.use=not r.use end
					end
					pcall(refreshRows)
				end)
				rowBtns[name]=b
			end
			local u=rec.use
			local tag=(u==nil) and "[..] " or (u and "[ON] " or "[OFF] ")
			local sig=(rec.sig~="") and rec.sig or "?"
			b.Text=tag..name.."  "..sig.."  tembak "..(rec.mod or 0).." kena "..(rec.hit or 0)
			b.BackgroundColor3=u and ACC or ROW
			b.TextColor3=u and BLACK or DIM
		end
	end
	local function clearRows()
		for _,b in pairs(rowBtns) do pcall(function() b:Destroy() end) end
		rowBtns={}
	end

	-- ===== status =====
	local noteText,noteUntil=nil,0
	local function note(t) noteText=t; noteUntil=os.clock()+3 end

	local function computeVerdict()
		if not canHook then return "Executor tidak support hookmetamethod. Silent aim tidak bisa." end
		if not ST.hooked then return "Hook belum aktif. Nyalakan SILENT AIM untuk memasang hook." end
		if not ST.on then return "Nyalakan SILENT AIM untuk mulai." end
		local mods,hits,dirName=0,0,nil
		for name,rec in pairs(ST.seen) do
			if rec.n>0 and (rec.use or looksLikeShot(name)) then
				if rec.hasDir and not dirName then dirName=name end
				if rec.use then
					mods=mods+(rec.mod or 0)
					hits=hits+(rec.hit or 0)
				end
			end
		end
		if mods>0 then
			local best,bh,bn=bestSpeedInfo()
			local info=best and (" | kecepatan terbaik "..best.." ("..bh.."/"..bn..")") or ""
			if hits==0 and mods>=5 then
				return "Belum ada yang kena dari "..mods.." tembakan"..info..". Server mungkin menghitung kena sendiri."
			end
			return "Kena "..hits.." dari "..mods.." tembakan"..info.."."
		end
		if dirName then return "BISA: "..dirName.." mengirim arah. Tembak sekali lagi dan pastikan remote [ON]." end
		if not next(ST.seen) then return "Tembak / lempar sekali. Remote akan muncul di daftar." end
		return "TIDAK BISA: serangan tidak mengirim arah lewat remote (server/hitbox yang hitung)."
	end

	-- ===== kontrol =====
	P.toggle("silentOn","SILENT AIM",false,function(on)
		ST.onToggle=on
		if on then
			local ok=installHook()
			if not ok then notify("Silent aim","Hook gagal / tidak didukung executor") end
		end
	end)
	P.toggle("silentHead","BIDIK KEPALA (OFF = dada)",false,function(on)
		ST.aimHead=on
	end)
	P.toggle("silentPred","PREDIKSI GERAK",true,function(on)
		ST.predict=on
	end)
	P.toggle("silentFilter","FILTER NAMA TEMBAK",true,function(on)
		ST.filterShot=on
	end)
	P.toggle("silentTouch","PAKSA KENA (touch, jarak dekat)",false,function(on)
		ST.forceTouch=on
	end)
	local statusLbl=P.info("Peran: -",24)
	local verdictLbl=P.info("",62)
	P.button("CEK TOOL",function()
		local ch=lp.Character
		local tool=ch and ch:FindFirstChildOfClass("Tool")
		if not tool then note("Pegang senjata / tombak dulu, lalu tap CEK TOOL."); return end
		local found=0
		for _,d in ipairs(tool:GetDescendants()) do
			if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
				found=found+1
				if not ST.seen[d.Name] and ST.count<MAX_REMOTES then
					ST.count=ST.count+1
					ST.seen[d.Name]={n=0,mod=0,hit=0,sig="",hasDir=false,order=ST.count,use=presetUse(d.Name)}
				end
			end
		end
		pcall(refreshRows)
		if found==0 then note("Tidak ada remote di tool ini. Serang sekali, lalu lihat daftar.") end
	end,Color3.fromRGB(150,80,20))
	P.button("HAPUS DAFTAR",function()
		clearRows()
		ST.seen={}
		ST.count=0
	end,SIDE2)

	-- ===== loop status target =====
	task.spawn(function()
		while main.Parent and ST.gen==gen do
			pcall(updateTarget)
			if ST.on then
				if ST.targetPlr then
					statusLbl.Text=string.format("Peran: %s | ON | Target: %s [%dm]",ST.role,ST.targetPlr.DisplayName,ST.targetDist or 0)
				else
					statusLbl.Text=string.format("Peran: %s | ON | tidak ada musuh",ST.role)
				end
			else
				statusLbl.Text=string.format("Peran: %s | OFF",ST.role)
			end
			task.wait(0.15)
		end
	end)
	-- ===== loop tampilan =====
	task.spawn(function()
		while main.Parent and ST.gen==gen do
			if P.page.Visible then
				pcall(refreshRows)
				if os.clock()<noteUntil and noteText then
					verdictLbl.Text=noteText
				else
					verdictLbl.Text=computeVerdict()
				end
			end
			task.wait(0.5)
		end
	end)
end

