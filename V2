section("ESP",function()
	local P=addTab("Esp","ESP PEMAIN")
	local espMaster=false
	local HIDE_TEAMS={Spectator=true}
	local espOver,espOff,espObjs,espRows={},{},{},{}

	P.toggle("espPlayer","ESP PEMAIN",false,function(on)
		espMaster=on
		if not on then
			for pl in pairs(espObjs) do
				local o=espObjs[pl]
				pcall(function() o.hl:Destroy() end)
				pcall(function() o.bb:Destroy() end)
				espObjs[pl]=nil
			end
		end
	end)
	local colPlayer=P.colors("colPlayer","Warna semua pemain",5)
	local colKiller=P.colors("colKiller","Warna killer",1)
	P.info("Per pemain: kotak warna = ganti warna, ON/OFF = tampil/sembunyi. ESP hanya muncul saat pemain di balik tembok.",52)
	local list=P.container()

	local function isKiller(pl)
		return pl.Team~=nil and pl.Team.Name=="Killer"
	end
	local function teamHidden(pl)
		return pl.Team~=nil and HIDE_TEAMS[pl.Team.Name]==true
	end
	local function effColor(pl)
		if espOver[pl] then return PALETTE[espOver[pl]].c end
		if isKiller(pl) then return PALETTE[colKiller.value].c end
		return PALETTE[colPlayer.value].c
	end

	local function paintRows()
		for pl,r in pairs(espRows) do
			local on=not espOff[pl]
			r.chip.BackgroundColor3=effColor(pl)
			r.tog.Text=on and "ON" or "OFF"
			r.tog.BackgroundColor3=on and ACC or OFFBG
			r.tog.TextColor3=on and BLACK or DIM
			r.name.Text=(espOver[pl] and "* " or "")..pl.DisplayName
		end
	end

	local function buildList()
		for _,c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		espRows={}
		for pl in pairs(espOver) do if not pl.Parent then espOver[pl]=nil end end
		for pl in pairs(espOff) do if not pl.Parent then espOff[pl]=nil end end
		for _,pl in ipairs(Players:GetPlayers()) do
			if pl~=lp then
				local row=new("Frame",{Size=UDim2.new(1,0,0,28),BackgroundColor3=ROW},list)
				corner(row,6)
				local chip=new("TextButton",{
					Position=UDim2.new(0,6,0.5,-10),Size=UDim2.new(0,20,0,20),Text="",AutoButtonColor=false,
				},row)
				corner(chip,5)
				local name=new("TextLabel",{
					BackgroundTransparency=1,Position=UDim2.new(0,32,0,0),Size=UDim2.new(1,-96,1,0),
					Font=FONT,Text="",TextColor3=TXT,TextSize=12,
					TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,
				},row)
				local tog=new("TextButton",{
					Position=UDim2.new(1,-56,0.5,-10),Size=UDim2.new(0,50,0,20),
					Font=FONTB,Text="ON",TextSize=12,AutoButtonColor=true,
				},row)
				corner(tog,5)
				chip.MouseButton1Click:Connect(function()
					local cur=espOver[pl] or 0
					espOver[pl]=(cur%#PALETTE)+1
					paintRows()
				end)
				tog.MouseButton1Click:Connect(function()
					espOff[pl]=(not espOff[pl]) or nil
					paintRows()
				end)
				espRows[pl]={chip=chip,name=name,tog=tog}
			end
		end
		paintRows()
	end
	onPlayers(buildList)

	local function removeEsp(pl)
		local o=espObjs[pl]
		if o then
			pcall(function() o.hl:Destroy() end)
			pcall(function() o.bb:Destroy() end)
			espObjs[pl]=nil
		end
	end

	local espParams=RaycastParams.new()
	espParams.FilterType=Enum.RaycastFilterType.Exclude
	local function isHidden(char,hrp)
		local cam=workspace.CurrentCamera
		if not cam then return false end
		local ign={char}
		if lp.Character then table.insert(ign,lp.Character) end
		espParams.FilterDescendantsInstances=ign
		local origin=cam.CFrame.Position
		local points={hrp.Position}
		local head=char:FindFirstChild("Head")
		if head then table.insert(points,head.Position) end
		for _,pos in ipairs(points) do
			if not workspace:Raycast(origin,pos-origin,espParams) then return false end
		end
		return true
	end

	local function applyEsp(pl,myHrp)
		local char=pl.Character
		local hrp=char and char:FindFirstChild("HumanoidRootPart")
		if not (espMaster and not espOff[pl] and not teamHidden(pl) and hrp) then
			removeEsp(pl)
			return
		end
		local o=espObjs[pl]
		if o and o.char~=char then removeEsp(pl); o=nil end
		if not o then
			local hl=new("Highlight",{
				Adornee=char,FillTransparency=0.6,OutlineTransparency=0,
				DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
			},espFolder)
			local bb=new("BillboardGui",{
				Adornee=hrp,Size=UDim2.new(0,120,0,18),
				StudsOffset=Vector3.new(0,3.4,0),AlwaysOnTop=true,ResetOnSpawn=false,
			},espFolder)
			local lbl=new("TextLabel",{
				BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),
				Font=FONTB,TextSize=12,TextStrokeTransparency=0.4,
			},bb)
			o={hl=hl,bb=bb,lbl=lbl,char=char}
			espObjs[pl]=o
		end
		local col=effColor(pl)
		o.hl.FillColor=col
		o.hl.OutlineColor=col
		o.lbl.TextColor3=col
		o.hl.Enabled=isHidden(char,hrp)
		local dist=myHrp and (hrp.Position-myHrp.Position).Magnitude or 0
		o.lbl.Text=string.format("%s [%dm]",pl.DisplayName,dist)
	end

	task.spawn(function()
		while main.Parent do
			task.wait(0.3)
			if P.page.Visible then paintRows() end
			if espMaster then
				local myHrp=getHRP(lp)
				for _,pl in ipairs(Players:GetPlayers()) do
					if pl~=lp then applyEsp(pl,myHrp) end
				end
				for pl in pairs(espObjs) do
					if not pl.Parent then removeEsp(pl) end
				end
			end
		end
	end)
end)

