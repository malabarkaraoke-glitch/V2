section("GOD",function()
	local P=addTab("God","GOD")
	local GOD_HP=100000
	local godOn,noTouchOn=false,false
	local origMax=100
	local lastSafeCFrame=nil
	local godConns={}
	local touchConn=nil

	local function clearGodConns()
		for _,c in ipairs(godConns) do pcall(function() c:Disconnect() end) end
		godConns={}
	end
	local function setNoTouch(char,on)
		for _,p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and not p:FindFirstAncestorOfClass("Tool") then
				pcall(function() p.CanTouch=not on end)
			end
		end
	end
	local function applyNoTouch()
		if touchConn then touchConn:Disconnect(); touchConn=nil end
		local char=lp.Character
		if not char then return end
		local on=(godOn and noTouchOn)
		setNoTouch(char,on)
		if on then
			touchConn=char.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") and not d:FindFirstAncestorOfClass("Tool") then
					pcall(function() d.CanTouch=false end)
				end
			end)
		end
	end

	-- sumber darah lain
	local hpSources={}
	local hpSeen=setmetatable({},{__mode="k"})
	local hpSeenAttr=setmetatable({},{__mode="k"})
	local function isHpName(n)
		local l=string.lower(n)
		if string.find(l,"max",1,true) then return false end
		for _,w in ipairs({"health","hp","darah","blood","life","vitality"}) do
			if string.find(l,w,1,true) then return true end
		end
		return false
	end
	local function readSrc(r)
		if r.kind=="value" then return r.obj.Value end
		return r.inst:GetAttribute(r.name)
	end
	local function scanParent(parent,deep)
		if not parent then return end
		local items=deep and parent:GetDescendants() or parent:GetChildren()
		for _,d in ipairs(items) do
			if (d:IsA("NumberValue") or d:IsA("IntValue")) and isHpName(d.Name) and not hpSeen[d] then
				hpSeen[d]=true
				table.insert(hpSources,{kind="value",obj=d,max=d.Value})
			end
		end
		for name,val in pairs(parent:GetAttributes()) do
			if type(val)=="number" and isHpName(name) then
				hpSeenAttr[parent]=hpSeenAttr[parent] or {}
				if not hpSeenAttr[parent][name] then
					hpSeenAttr[parent][name]=true
					table.insert(hpSources,{kind="attr",inst=parent,name=name,max=val})
				end
			end
		end
	end
	local function scanHp()
		local char=lp.Character
		if char then scanParent(char,true) end
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if hum then scanParent(hum,false) end
		for _,c in ipairs(lp:GetChildren()) do
			if c.Name~="PlayerGui" then scanParent(c,true) end
		end
		scanParent(lp,false)
		local rs=game:GetService("ReplicatedStorage")
		local pf=rs:FindFirstChild(lp.Name) or rs:FindFirstChild(tostring(lp.UserId))
		if pf then scanParent(pf,true) end
		local ls=lp:FindFirstChild("leaderstats")
		if ls then scanParent(ls,false) end
		for i=#hpSources,1,-1 do
			local r=hpSources[i]
			local parent=(r.kind=="value") and r.obj.Parent or r.inst.Parent
			if not parent then
				table.remove(hpSources,i)
			else
				local cur=readSrc(r)
				if type(cur)=="number" and cur>r.max then r.max=cur end
			end
		end
	end
	local function healSources(force)
		for _,r in ipairs(hpSources) do
			local cur=readSrc(r)
			if type(cur)=="number" and cur~=r.max and (force or cur<r.max) then
				if r.kind=="value" then
					pcall(function() r.obj.Value=r.max end)
				else
					pcall(function() r.inst:SetAttribute(r.name,r.max) end)
				end
			end
		end
	end

	local function setupChar(char)
		local hum=char:WaitForChild("Humanoid",10)
		local hrp=char:WaitForChild("HumanoidRootPart",10)
		if not hum or not hrp then return end
		clearGodConns()
		if godOn then
			hum.MaxHealth=GOD_HP
			hum.Health=GOD_HP
			pcall(function() hum.BreakJointsOnDeath=false end)
			pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead,false) end)
			table.insert(godConns,hum.Died:Connect(function()
				if not godOn then return end
				task.wait(0.1)
				if lastSafeCFrame then hrp.CFrame=lastSafeCFrame end
				hum.MaxHealth=GOD_HP
				hum.Health=GOD_HP
			end))
			table.insert(godConns,hum.HealthChanged:Connect(function()
				if godOn and hum.Parent and hum.Health<hum.MaxHealth then
					hum.Health=hum.MaxHealth
				end
			end))
		end
		applyNoTouch()
	end

	-- UI
	P.toggle("god","GOD MODE",false,function(on)
		godOn=on
		local char=lp.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if on then
			if hum and hum.MaxHealth<GOD_HP then origMax=hum.MaxHealth end
			if char then task.spawn(setupChar,char) end
			notify("GOD MODE ON","HP terkunci")
		else
			clearGodConns()
			if hum then
				hum.MaxHealth=origMax
				hum.Health=origMax
				pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead,true) end)
			end
			applyNoTouch()
			notify("GOD MODE OFF","HP normal lagi")
		end
	end)
	P.toggle("noTouch","KEBAL TOOL",false,function(on)
		noTouchOn=on
		applyNoTouch()
		if on then notify("Kebal tool ON","Aktif saat GOD MODE ON") end
	end)
	P.button("FULL HP SEKARANG",function()
		local char=lp.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.Health=hum.MaxHealth end
		scanHp()
		healSources(true)
		notify("HP Full","Darah diisi penuh")
	end,Color3.fromRGB(150,80,20))
	local hpLbl=P.info("HP: -",24)
	local posLbl=P.info("Posisi: -",24)
	local srcLbl=P.info("Sumber HP: mencari...",40)

	track(RunService.Heartbeat:Connect(function()
		local char=lp.Character
		local hrp=char and char:FindFirstChild("HumanoidRootPart")
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum then
			if godOn then
				if hum.MaxHealth~=GOD_HP then hum.MaxHealth=GOD_HP end
				if hum.Health<GOD_HP then hum.Health=GOD_HP end
				healSources(false)
			end
			if hum.Health>0 then
				lastSafeCFrame=hrp.CFrame
			end
		end
	end))

	task.spawn(function()
		while main.Parent do
			task.wait(0.33)
			if Frame.Visible and P.page.Visible then
				local char=lp.Character
				local hrp=char and char:FindFirstChild("HumanoidRootPart")
				local hum=char and char:FindFirstChildOfClass("Humanoid")
				if hrp and hum then
					local p=hrp.Position
					posLbl.Text=string.format("Posisi: %.0f, %.0f, %.0f",p.X,p.Y,p.Z)
					local hp=hum.Health
					if godOn and hp>=GOD_HP*0.99 then
						hpLbl.Text="HP: GOD (terkunci)"
					else
						hpLbl.Text=string.format("HP: %.0f / %.0f",hp,hum.MaxHealth)
					end
				end
			end
		end
	end)

	local watchChar,watchHum=nil,nil
	task.spawn(function()
		while main.Parent do
			task.wait(0.3)
			local c=lp.Character
			local h=c and c:FindFirstChildOfClass("Humanoid")
			if c and h and (c~=watchChar or h~=watchHum) then
				watchChar,watchHum=c,h
				if godOn then task.spawn(setupChar,c) end
			end
		end
	end)

	task.spawn(function()
		while main.Parent do
			if godOn or (Frame.Visible and P.page.Visible) then
				scanHp()
				local names={}
				for i=1,math.min(3,#hpSources) do
					local r=hpSources[i]
					names[i]=(r.kind=="value") and r.obj.Name or r.name
				end
				srcLbl.Text="Sumber HP: Humanoid"..((#names>0) and (" + "..table.concat(names,", ")) or " saja")
			end
			task.wait(godOn and 2 or 3)
		end
	end)
end)

