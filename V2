local lastFire=0
local function fireTool(targetPart)
	local now=os.clock()
	if now-lastFire<0.08 then return false end
	local char=lp.Character
	local tool=char and char:FindFirstChildOfClass("Tool")
	if not tool then return false end
	lastFire=now
	pcall(function() tool:Activate() end)
	local handle=tool:FindFirstChild("Handle")
	if handle and targetPart and firetouchinterest then
		pcall(function()
			firetouchinterest(targetPart,handle,0)
			firetouchinterest(targetPart,handle,1)
		end)
	end
	return true
end

