local tabs={}
local function showTab(n)
	for i,t in ipairs(tabs) do
		local on=(i==n)
		t.page.Visible=on
		t.btn.BackgroundColor3=on and ACC or SIDE2
		t.btn.TextColor3=on and BLACK or TXT
	end
	if tabs[n] then TitleLbl.Text=tabs[n].title end
end

local function addTab(label,title)
	local idx=#tabs+1
	local btn=new("TextButton",{
		Size=UDim2.new(1,-8,0,26),BackgroundColor3=SIDE2,Font=FONTB,Text=label,
		TextColor3=TXT,TextSize=13,LayoutOrder=idx,AutoButtonColor=false,
	},sidebar)
	corner(btn,6)
	local page=new("ScrollingFrame",{
		BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),BorderSizePixel=0,
		ScrollBarThickness=3,ScrollBarImageColor3=ACC,CanvasSize=UDim2.new(0,0,0,0),
		AutomaticCanvasSize=Enum.AutomaticSize.Y,Visible=false,
	},content)
	new("UIListLayout",{
		Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder,
		HorizontalAlignment=Enum.HorizontalAlignment.Center,
	},page)
	new("UIPadding",{PaddingTop=UDim.new(0,2),PaddingBottom=UDim.new(0,6)},page)
	tabs[idx]={btn=btn,page=page,title=title}
	btn.MouseButton1Click:Connect(function() showTab(idx) end)

	local P={page=page}
	local n=0
	local function ord() n=n+1 return n end

	function P.row(h)
		local row=new("Frame",{Size=UDim2.new(1,-8,0,h or 30),BackgroundColor3=ROW,LayoutOrder=ord()},page)
		corner(row,6)
		return row
	end
	function P.rowLabel(row,text)
		return new("TextLabel",{
			BackgroundTransparency=1,Position=UDim2.new(0,8,0,0),Size=UDim2.new(1,-100,1,0),
			Font=FONT,Text=text,TextColor3=TXT,TextSize=13,
			TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,
		},row)
	end
	function P.rowButton(row,text,w,fromRight)
		local b=new("TextButton",{
			Position=UDim2.new(1,-((fromRight or 6)+w),0.5,-11),Size=UDim2.new(0,w,0,22),
			BackgroundColor3=OFFBG,Font=FONTB,Text=text,TextColor3=TXT,TextSize=13,
			AutoButtonColor=true,
		},row)
		corner(b,5)
		return b
	end
	function P.info(text,h)
		local l=new("TextLabel",{
			Size=UDim2.new(1,-8,0,h or 24),BackgroundColor3=ROW,Font=FONT,Text=text,
			TextColor3=DIM,TextSize=12,TextWrapped=true,
			TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
			LayoutOrder=ord(),
		},page)
		corner(l,6)
		new("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,6),PaddingTop=UDim.new(0,4)},l)
		return l
	end
	function P.button(text,cb,color)
		local b=new("TextButton",{
			Size=UDim2.new(1,-8,0,30),BackgroundColor3=color or SIDE2,Font=FONTB,Text=text,
			TextColor3=TXT,TextSize=14,LayoutOrder=ord(),AutoButtonColor=true,
		},page)
		corner(b,6)
		b.MouseButton1Click:Connect(function() if cb then cb() end end)
		return b
	end
	function P.container()
		local f=new("Frame",{
			Size=UDim2.new(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,
			BackgroundTransparency=1,LayoutOrder=ord(),
		},page)
		new("UIListLayout",{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder},f)
		return f
	end
	function P.toggle(key,label,default,cb)
		local row=P.row(30)
		P.rowLabel(row,label)
		local btn=P.rowButton(row,"OFF",58)
		local c={value=false,default=default and true or false}
		local function paint()
			btn.Text=c.value and "ON" or "OFF"
			btn.BackgroundColor3=c.value and ACC or OFFBG
			btn.TextColor3=c.value and BLACK or DIM
		end
		function c.set(v,quiet)
			c.value=v and true or false
			paint()
			if cb and not quiet then cb(c.value) end
			queueSave()
		end
		function c.get() return c.value end
		btn.MouseButton1Click:Connect(function() c.set(not c.value) end)
		c.value=c.default
		paint()
		if c.default and cb then pcall(cb,true) end
		if key then controls[key]=c end
		return c
	end
	function P.colors(key,label,default,cb)
		local row=P.row(48)
		new("TextLabel",{
			BackgroundTransparency=1,Position=UDim2.new(0,8,0,2),Size=UDim2.new(1,-16,0,16),
			Font=FONT,Text=label,TextColor3=DIM,TextSize=11,
			TextXAlignment=Enum.TextXAlignment.Left,
		},row)
		local c={value=default,default=default}
		local sw={}
		local function paint()
			for i,s in ipairs(sw) do s.Enabled=(i==c.value) end
		end
		function c.set(i,quiet)
			i=math.clamp(math.floor(tonumber(i) or c.default),1,#PALETTE)
			c.value=i
			paint()
			if cb and not quiet then cb(i) end
			queueSave()
		end
		function c.get() return c.value end
		for i,p in ipairs(PALETTE) do
			local b=new("TextButton",{
				BackgroundColor3=p.c,Text="",AutoButtonColor=false,
				Position=UDim2.new(0,8+(i-1)*26,0,22),Size=UDim2.new(0,22,0,20),
			},row)
			corner(b,5)
			sw[i]=new("UIStroke",{
				Color=Color3.fromRGB(255,255,255),Thickness=2,Enabled=false,
				ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
			},b)
			b.MouseButton1Click:Connect(function() c.set(i) end)
		end
		paint()
		if key then controls[key]=c end
		return c
	end
	return P
end

local function section(name,fn)
	local ok,err=pcall(fn)
	if not ok then
		warn("["..name.." ERROR] "..tostring(err))
	end
end

