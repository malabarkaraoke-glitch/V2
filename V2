section("LAMPU",function()
	local P=addTab("Lampu","LAMPU")
	local lampOn=false
	local lampLevel=3
	local lampSaved=nil
	local lampAtm=nil
	local lampCC=nil

	local lvlLbl=P.info("Terang: 3 / 5",24)
	local pmRow=P.row(34)
	local minus=new("TextButton",{
		BackgroundColor3=SIDE2,Position=UDim2.new(0,6,0.5,-12),Size=UDim2.new(0.5,-9,0,24),
		Font=FONTB,Text="-",TextColor3=TXT,TextSize=20,AutoButtonColor=true,
	},pmRow)
	corner(minus,5)
	local plus=new("TextButton",{
		BackgroundColor3=ACC,Position=UDim2.new(0.5,3,0.5,-12),Size=UDim2.new(0.5,-9,0,24),
		Font=FONTB,Text="+",TextColor3=BLACK,TextSize=20,AutoButtonColor=true,
	},pmRow)
	corner(plus,5)

	local function applyLamp()
		local lv=lampLevel
		local amb=math.min(255,70+lv*30)
		Lighting.Brightness=1+lv
		Lighting.ClockTime=14
		Lighting.FogEnd=1000000
		Lighting.GlobalShadows=false
		Lighting.Ambient=Color3.fromRGB(amb,amb,amb)
		Lighting.OutdoorAmbient=Color3.fromRGB(amb,amb,amb)
		pcall(function() Lighting.ExposureCompensation=lv*0.4 end)
		local atm=Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density=0; atm.Haze=0 end
		if not lampCC or lampCC.Parent~=Lighting then
			if lampCC then pcall(function() lampCC:Destroy() end) end
			lampCC=new("ColorCorrectionEffect",{},Lighting)
		end
		lampCC.Brightness=0.03*lv
		lampCC.Contrast=0.05
	end

	local function setLevel(v)
		lampLevel=math.clamp(math.floor(tonumber(v) or 3),1,5)
		lvlLbl.Text=string.format("Terang: %d / 5",lampLevel)
		if lampOn then applyLamp() end
		queueSave()
	end
	minus.MouseButton1Click:Connect(function() setLevel(lampLevel-1) end)
	plus.MouseButton1Click:Connect(function() setLevel(lampLevel+1) end)
	controls.lampLevel={default=3,get=function() return lampLevel end,set=function(v) setLevel(v) end}

	P.toggle("lamp","LAMPU",false,function(on)
		lampOn=on
		if on then
			lampSaved={
				Brightness=Lighting.Brightness,ClockTime=Lighting.ClockTime,
				FogEnd=Lighting.FogEnd,GlobalShadows=Lighting.GlobalShadows,
				Ambient=Lighting.Ambient,OutdoorAmbient=Lighting.OutdoorAmbient,
			}
			pcall(function() lampSaved.ExposureCompensation=Lighting.ExposureCompensation end)
			local atm=Lighting:FindFirstChildOfClass("Atmosphere")
			lampAtm=atm and {obj=atm,Density=atm.Density,Haze=atm.Haze} or nil
			applyLamp()
			notify("LAMPU ON","Layar jadi terang")
		else
			if lampSaved then
				for k,v in pairs(lampSaved) do pcall(function() Lighting[k]=v end) end
			end
			if lampAtm and lampAtm.obj and lampAtm.obj.Parent then
				lampAtm.obj.Density=lampAtm.Density
				lampAtm.obj.Haze=lampAtm.Haze
			end
			if lampCC then pcall(function() lampCC:Destroy() end); lampCC=nil end
			notify("LAMPU OFF","Pencahayaan normal")
		end
	end)

	task.spawn(function()
		while main.Parent do
			task.wait(1)
			if lampOn then applyLamp() end
		end
	end)
end)

