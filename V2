section("GENERATOR",function()
	local P=addTab("Generator","AUTO GENERATOR")
	local pg=lp:WaitForChild("PlayerGui")

	-- ===== PENGATURAN =====
	local mode="off"             -- off / sukses / instan
	local RANGE={116,159}        -- zona putih (mode sukses)
	local INSTANT_TARGET=109     -- posisi jarum untuk mode instan
	local INSTANT_DELAY=0.02
	local RETRY_AFTER=0.25
	local EXTRA_LEAD=0.02
	local FLEE_DIST=45
	local FLEE_COOLDOWN=2
	local SCAN_EVERY=4
	local STAY_NO_PROMPT=4
	local PCT_WORDS={"progress","percent","repair","charge"}
	local LABU_COL=Color3.fromRGB(255,140,0)
	local WIN_COL=Color3.fromRGB(0,200,255)

	-- ===== SKILLCHECK (objek di-cache) =====
	local cache={t=0}
	local function alive(o) return o~=nil and o.Parent~=nil end
	local function refreshObjs()
		local now=os.clock()
		if now-cache.t<0.1 then return end
		cache.t=now
		local gui=pg:FindFirstChild("SkillCheckPromptGui")
		cache.gui=gui
		cache.line=gui and gui:FindFirstChild("Line",true)
		cache.goal=gui and gui:FindFirstChild("Goal",true)
		local mob=pg:FindFirstChild("Survivor-mob")
		cache.action=mob and mob:FindFirstChild("action",true)
	end
	local function getObjs()
		if not (alive(cache.gui) and alive(cache.line) and alive(cache.goal) and alive(cache.action)) then
			refreshObjs()
		end
		return cache.gui,cache.line,cache.goal,cache.action
	end
	local function isShown(o)
		while o and o~=pg do
			if o:IsA("GuiObject") and not o.Visible then return false end
			if o:IsA("ScreenGui") and not o.Enabled then return false end
			o=o.Parent
		end
		return true
	end
	local function fireAll(signalGetter)
		local ok1,sig=pcall(signalGetter)
		if not ok1 or not sig then return false end
		local done=false
		if getconnections then
			local ok2,list=pcall(getconnections,sig)
			if ok2 and list then
				for _,c in ipairs(list) do
					pcall(function() c:Fire() end)
					done=true
				end
			end
		end
		if not done and firesignal then
			done=pcall(firesignal,sig)
		end
		return done
	end
	local function pressSignal(btn)
		fireAll(function() return btn.MouseButton1Down end)
		fireAll(function() return btn.MouseButton1Up end)
		fireAll(function() return btn.MouseButton1Click end)
		fireAll(function() return btn.Activated end)
	end
	local function pressClick(btn)
		local VIM=game:GetService("VirtualInputManager")
		local p=btn.AbsolutePosition+btn.AbsoluteSize/2
		local inset=GuiService:GetGuiInset()
		local x,y=p.X,p.Y+inset.Y
		pcall(function()
			VIM:SendMouseButtonEvent(x,y,0,true,game,0)
			VIM:SendMouseButtonEvent(x,y,0,false,game,0)
		end)
	end
	local pressCount=0
	local function pressAction(btn)
		if not btn then return end
		pressCount=pressCount+1
		-- sinyal tombol + klik layar sekaligus (sinyal saja kadang tidak dihitung game)
		pressSignal(btn)
		pressClick(btn)
	end
	local function relAngle(line,goal) return (line.Rotation-goal.Rotation)%360 end
	local function inRange(x,r) return x>=r[1] and x<=r[2] end
	local function crosses(a,b,m)
		local d=(b-a+180)%360-180
		local k=(m-a+180)%360-180
		if d>=0 then return k>=0 and k<=d end
		return k<=0 and k>=d
	end
	local function getLead()
		local ping=0
		pcall(function() ping=lp:GetNetworkPing() end)
		return ping+EXTRA_LEAD
	end

	local fired,firedAt,seenAt=false,0,nil
	local lastStatus="mati"
	local lastRel,lastT=nil,nil

	local function step()
		local gui,line,goal,action=getObjs()
		if not gui then
			lastStatus="SkillCheckPromptGui tidak ada"
		elseif not line or not goal then
			lastStatus="Line/Goal tidak ketemu"
		elseif not action then
			lastStatus="tombol action tidak ketemu"
		elseif not isShown(line) then
			lastStatus="skillcheck belum muncul"
		else
			lastStatus=string.format("AKTIF rel=%.1f",relAngle(line,goal))
		end

		if not (gui and line and goal and action) or not isShown(line) then
			fired=false
			seenAt=nil
			lastRel,lastT=nil,nil
			return
		end

		local now=os.clock()
		local rel=relAngle(line,goal)
		local speed=0
		if lastRel and lastT and now>lastT then
			local d=(rel-lastRel+180)%360-180
			speed=d/(now-lastT)
		end
		lastRel,lastT=rel,now

		if fired then
			if now-firedAt>RETRY_AFTER then
				fired=false
				seenAt=nil
			else
				return
			end
		end

		if mode=="instan" then
			seenAt=seenAt or now
			if now-seenAt>=INSTANT_DELAY then
				fired=true
				firedAt=now
				line.Rotation=goal.Rotation+INSTANT_TARGET
				task.spawn(function()
					RunService.Heartbeat:Wait()
					pcall(function() line.Rotation=goal.Rotation+INSTANT_TARGET end)
					pressAction(action)
				end)
			end
		else -- sukses: prediksi, jarum cepat tetap kena
			local mid=(RANGE[1]+RANGE[2])/2
			local predicted=(rel+speed*getLead())%360
			if inRange(rel,RANGE) or crosses(rel,predicted,mid) then
				fired=true
				firedAt=now
				pressAction(action)
			end
		end
	end

	-- dibungkus pcall supaya error tidak menghentikan skillcheck
	local function safeStep()
		if mode=="off" then
			lastStatus="mati"
			return
		end
		local okS,eS=pcall(step)
		if not okS then lastStatus="error: "..tostring(eS) end
	end
	pcall(function() RunService:UnbindFromRenderStep("DeltaPart5_SC") end)
	RunService:BindToRenderStep("DeltaPart5_SC",Enum.RenderPriority.Last.Value,safeStep)
	track(RunService.Heartbeat:Connect(safeStep))

	-- =================================================================
	-- DATA GENERATOR / PALET
	-- =================================================================
	local gens,pals={},{}
	local skip=setmetatable({},{__mode="k"})
	local pctCache=setmetatable({},{__mode="k"})
	local promptCache=setmetatable({},{__mode="k"})
	local scanning=false
	local lastScan=0
	local function needScan() lastScan=0 end

	local function nameHas(n,w)
		return string.find(string.lower(n),w,1,true)~=nil
	end
	local function isPalletName(n)
		local l=string.lower(n)
		if string.find(l,"box",1,true) or string.find(l,"crate",1,true) or string.find(l,"container",1,true) then
			return false
		end
		return string.find(l,"pallet",1,true)~=nil or string.find(l,"palet",1,true)~=nil
	end
	local function scanMap()
		if scanning then return end
		scanning=true
		lastScan=os.clock()
		pcall(function()
			local g,p={},{}
			local i=0
			for _,d in ipairs(workspace:GetDescendants()) do
				i=i+1
				if i%1500==0 then task.wait() end
				if d:IsA("Model") and not Players:GetPlayerFromCharacter(d) then
					local isG=nameHas(d.Name,"generator")
					local isP=(not isG) and isPalletName(d.Name)
					if isG or isP then
						local par=d.Parent
						local nested=par and par:IsA("Model")
							and (nameHas(par.Name,"generator") or nameHas(par.Name,"pallet"))
						if not nested then
							if isG then table.insert(g,d) else table.insert(p,d) end
						end
					end
				end
			end
			gens,pals=g,p
		end)
		scanning=false
	end
	local function mainPart(m)
		return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart",true)
	end
	local function genPos(g)
		local ok1,cf=pcall(function() return g:GetPivot() end)
		if ok1 and cf then return cf.Position end
		local p=mainPart(g)
		return p and p.Position or Vector3.zero
	end

	-- ----- baca persen -----
	local function isPctName(n)
		local l=string.lower(n)
		for _,bad in ipairs({"max","speed","rate","time","total","skill"}) do
			if string.find(l,bad,1,true) then return false end
		end
		for _,w in ipairs(PCT_WORDS) do
			if string.find(l,w,1,true) then return true end
		end
		return false
	end
	local function findPctSource(g)
		local function checkAttrs(inst)
			for name,val in pairs(inst:GetAttributes()) do
				if type(val)=="number" and isPctName(name) then
					return {kind="attr",inst=inst,name=name,maxSeen=0,frac=false}
				end
			end
		end
		local s=checkAttrs(g)
		if s then return s end
		for _,d in ipairs(g:GetDescendants()) do
			if (d:IsA("NumberValue") or d:IsA("IntValue")) and isPctName(d.Name) then
				return {kind="val",inst=d,name=d.Name,maxSeen=0,frac=false}
			end
			if not d:IsA("BasePart") then
				s=checkAttrs(d)
				if s then return s end
			end
		end
		return nil
	end
	local function readPct(g)
		local c=pctCache[g]
		if not c or (not c.src and os.clock()-c.tried>5)
		or (c.src and not c.src.inst.Parent) then
			c={src=findPctSource(g),tried=os.clock()}
			pctCache[g]=c
		end
		local src=c.src
		if not src then return nil,nil end
		local v
		if src.kind=="val" then v=src.inst.Value else v=src.inst:GetAttribute(src.name) end
		if type(v)~="number" then return nil,nil end
		if v>src.maxSeen then src.maxSeen=v end
		if v>0 and v<1 then src.frac=true end
		local pct
		if src.maxSeen>1 then pct=v
		elseif src.frac then pct=v*100
		else pct=v end
		return math.clamp(pct,0,100),src.name
	end
	local function isDone(g)
		local p=readPct(g)
		return p~=nil and p>=99.5
	end
	local function fmtPct(p)
		return p and string.format("%d%%",math.floor(p+0.5)) or "?%"
	end

	-- ----- prompt repair -----
	local function getPrompts(g)
		local c=promptCache[g]
		if c and os.clock()-c.t<2 then return c.list end
		local list={}
		for _,d in ipairs(g:GetDescendants()) do
			if d:IsA("ProximityPrompt") then table.insert(list,d) end
		end
		promptCache[g]={t=os.clock(),list=list}
		return list
	end
	local function promptPos(p,g)
		local par=p.Parent
		if par and par:IsA("Attachment") then return par.WorldPosition end
		if par and par:IsA("BasePart") then return par.Position end
		return genPos(g)
	end

	-- ----- tempat berdiri di samping generator yang tidak terhalang -----
	local spotParams=RaycastParams.new()
	spotParams.FilterType=Enum.RaycastFilterType.Exclude
	pcall(function() spotParams.RespectCanCollide=true end)
	local overlap=OverlapParams.new()
	overlap.FilterType=Enum.RaycastFilterType.Exclude

	local function findSpot(g)
		local gp=genPos(g)
		local ps=getPrompts(g)
		local base=ps[1] and promptPos(ps[1],g) or gp
		local ign={g}
		if lp.Character then table.insert(ign,lp.Character) end
		spotParams.FilterDescendantsInstances=ign
		overlap.FilterDescendantsInstances=ign
		local hrp=getHRP(lp)
		local myPos=hrp and hrp.Position or base
		local maxDist=(ps[1] and ps[1].MaxActivationDistance or 10)-1
		local best,bestScore
		local loose,looseScore
		for _,r in ipairs({3.5,5,2.5}) do
			for k=0,11 do
				local a=(k/12)*math.pi*2
				local spot=Vector3.new(base.X+math.cos(a)*r,base.Y,base.Z+math.sin(a)*r)
				local hit=workspace:Raycast(spot+Vector3.new(0,5,0),Vector3.new(0,-16,0),spotParams)
				if hit and hit.Normal.Y>0.6 then
					local stand=hit.Position+Vector3.new(0,3,0)
					if (stand-base).Magnitude<=maxDist then
						local headRoom=workspace:Raycast(hit.Position+Vector3.new(0,0.5,0),Vector3.new(0,5.5,0),spotParams)
						local occupied=false
						local parts=workspace:GetPartBoundsInBox(CFrame.new(stand),Vector3.new(2.5,4,2.5),overlap)
						for _,pt in ipairs(parts) do
							if pt.CanCollide then occupied=true break end
						end
						if not headRoom and not occupied then
							local score=(stand-myPos).Magnitude+r*0.5
							local toGen=Vector3.new(base.X,stand.Y,base.Z)-stand
							local blocked=workspace:Raycast(stand,toGen,spotParams)
							if not blocked then
								if not bestScore or score<bestScore then best,bestScore=stand,score end
							end
							if not looseScore or score<looseScore then loose,looseScore=stand,score end
						end
					end
				end
			end
		end
		local pos=best or loose
		if not pos then return CFrame.new(base+Vector3.new(0,2,3)) end
		return CFrame.new(pos,Vector3.new(base.X,pos.Y,base.Z))
	end

	local function tpTo(g)
		local hrp=getHRP(lp)
		if not hrp then return end
		local ok1,cf=pcall(findSpot,g)
		if not ok1 or not cf then cf=CFrame.new(genPos(g)+Vector3.new(0,3,3)) end
		hrp.CFrame=cf
		pcall(function()
			hrp.AssemblyLinearVelocity=Vector3.zero
			hrp.AssemblyAngularVelocity=Vector3.zero
		end)
	end

	-- ----- repair otomatis (tahan sekali per prompt, tidak diputus berkala) -----
	local heldPrompt=nil
	local function releaseHold()
		if heldPrompt then
			local hp=heldPrompt
			heldPrompt=nil
			pcall(function() hp:InputHoldEnd() end)
		end
	end
	local function repair(g)
		local hrp=getHRP(lp)
		if not hrp then return false end
		local best,bd
		for _,p in ipairs(getPrompts(g)) do
			if p.Parent and p.Enabled then
				local d=(promptPos(p,g)-hrp.Position).Magnitude
				if not bd or d<bd then best,bd=p,d end
			end
		end
		if not best then
			releaseHold()
			return false
		end
		pcall(function() best.RequiresLineOfSight=false end)
		if fireproximityprompt then
			pcall(fireproximityprompt,best)
		else
			if heldPrompt~=best then
				releaseHold()
				heldPrompt=best
				pcall(function() best:InputHoldBegin() end)
			end
		end
		return true
	end

	-- ----- killer & pilih generator -----
	local function nearestKiller(myPos)
		local best,bd
		for _,pl in ipairs(Players:GetPlayers()) do
			if pl~=lp and pl.Team and nameHas(pl.Team.Name,"killer") then
				local h=getHRP(pl)
				if h then
					local d=(h.Position-myPos).Magnitude
					if not bd or d<bd then best,bd=h,d end
				end
			end
		end
		return best,bd
	end
	local function usable(g,exclude)
		if g==exclude or not g.Parent then return false end
		if skip[g] and skip[g]>os.clock() then return false end
		return not isDone(g)
	end
	local function pickNearest(pos)
		local best,bd
		for _,g in ipairs(gens) do
			if usable(g) then
				local d=(genPos(g)-pos).Magnitude
				if not bd or d<bd then best,bd=g,d end
			end
		end
		return best
	end
	local function pickFarthest(kpos,exclude)
		local best,bd
		for _,g in ipairs(gens) do
			if usable(g,exclude) then
				local d=(genPos(g)-kpos).Magnitude
				if not bd or d>bd then best,bd=g,d end
			end
		end
		return best
	end

	-- =================================================================
	-- ESP sorot per nama (dipakai LABU dan WINDOW). Hanya sorot, tanpa nama.
	-- Semua objek yang cocok disorot (tidak ada pengecualian untuk objek bertingkat).
	-- =================================================================
	local function makeNameEsp(matchFn,col)
		local tbl={}   -- objek -> highlight
		local on=false
		local function clear()
			for o,h in pairs(tbl) do
				pcall(function() h:Destroy() end)
				tbl[o]=nil
			end
		end
		local function tick()
			if not on then return end
			local want={}
			local n=0
			for _,d in ipairs(workspace:GetDescendants()) do
				if n>=500 then break end
				if (d:IsA("Model") or d:IsA("BasePart")) and matchFn(d.Name) and not Players:GetPlayerFromCharacter(d) then
					want[d]=true
					n=n+1
				end
			end
			for obj in pairs(want) do
				if not tbl[obj] or not tbl[obj].Parent then
					tbl[obj]=new("Highlight",{Adornee=obj,FillColor=col,
						OutlineColor=Color3.fromRGB(255,255,255),FillTransparency=0.4,
						DepthMode=Enum.HighlightDepthMode.AlwaysOnTop},espFolder)
				end
			end
			for obj,h in pairs(tbl) do
				if not want[obj] or not obj.Parent then
					pcall(function() h:Destroy() end)
					tbl[obj]=nil
				end
			end
		end
		task.spawn(function()
			while main.Parent do
				task.wait(1.5)
				pcall(tick)
			end
		end)
		return function(v)
			on=v and true or false
			if not on then clear() end
		end
	end
	local setLabu=makeNameEsp(function(n)
		local l=string.lower(n)
		return string.find(l,"pumpkin",1,true)~=nil or string.find(l,"labu",1,true)~=nil
	end,LABU_COL)

	-- =================================================================
	-- TOMBOL (P.toggle memakai key tetap supaya pengaturan tersimpan tetap terbaca)
	-- =================================================================
	local rushOn,fleeOn,pctOn,espGenOn,espPalOn=false,false,false,false,false
	local target=nil
	local lastFlee=0
	local lastTp=0
	local noPromptSince=nil
	local genStatus="mati"

	local tgSuk,tgIns
	tgSuk=P.toggle("genSuk","AUTO SUKSES",false,function(on)
		if on then
			mode="sukses"
			if tgIns and tgIns.value then tgIns.set(false,true) end
		elseif mode=="sukses" then
			mode="off"
		end
		fired=false
		seenAt=nil
		notify(on and "AUTO SUKSES ON" or "AUTO SUKSES OFF",on and "Jarum diprediksi, tekan tepat di putih" or "Dimatikan")
	end)
	tgIns=P.toggle("genIns","AUTO INSTAN",false,function(on)
		if on then
			mode="instan"
			if tgSuk and tgSuk.value then tgSuk.set(false,true) end
		elseif mode=="instan" then
			mode="off"
		end
		fired=false
		seenAt=nil
		notify(on and "AUTO INSTAN ON" or "AUTO INSTAN OFF",on and "Jarum langsung ke putih" or "Dimatikan")
	end)
	P.toggle("rush","RUSUH GENERATOR",false,function(on)
		rushOn=on
		target=nil
		noPromptSince=nil
		releaseHold()
		if on then
			needScan()
			notify("RUSUH ON","Teleport ke generator, repair sampai 100%")
		else
			notify("RUSUH OFF","Dimatikan")
		end
	end)
	P.toggle("flee","LARI DARI KILLER",false,function(on)
		fleeOn=on
		if on then needScan() end
		notify(on and "LARI ON" or "LARI OFF",on and "Killer dekat = teleport ke generator jauh" or "Dimatikan")
	end)
	P.toggle("pct","PERSEN GENERATOR",false,function(on)
		pctOn=on
		if on then needScan() end
	end)
	P.toggle("espGen","ESP GENERATOR",false,function(on)
		espGenOn=on
		if on then needScan() end
	end)
	local colGen=P.colors("colGen","Warna ESP generator",7)
	P.toggle("espPal","ESP PALET",false,function(on)
		espPalOn=on
		if on then needScan() end
	end)
	local colPal=P.colors("colPal","Warna ESP palet",3)
	P.toggle("espLabu","ESP LABU (Pumpkin)",false,function(on)
		setLabu(on)
		notify(on and "ESP LABU ON" or "ESP LABU OFF",on and "Semua Pumpkin disorot" or "Dimatikan")
	end)
	local statusLbl=P.info("status: ...",96)

	-- =================================================================
	-- LOOP SCAN (hanya jalan kalau ada fitur yang butuh)
	-- =================================================================
	task.spawn(function()
		while main.Parent do
			task.wait(1)
			if (rushOn or fleeOn or pctOn or espGenOn or espPalOn) and os.clock()-lastScan>SCAN_EVERY then
				pcall(scanMap)
			end
		end
	end)

	-- =================================================================
	-- LOOP RUSUH (tunggu 100% baru pindah) + LARI
	-- =================================================================
	local function rushTick()
		if rushOn or fleeOn then
			local hrp=getHRP(lp)
			if hrp then
				local kh,kd=nearestKiller(hrp.Position)
				if fleeOn and kh and kd<FLEE_DIST and os.clock()-lastFlee>FLEE_COOLDOWN then
					local g=pickFarthest(kh.Position,target)
					if g then
						releaseHold()
						target=g
						lastFlee=os.clock()
						lastTp=os.clock()
						noPromptSince=nil
						tpTo(g)
					end
				end
				if rushOn then
					if not target or not usable(target) then
						releaseHold()
						target=pickNearest(hrp.Position)
						noPromptSince=nil
						if target then
							tpTo(target)
							lastTp=os.clock()
						end
					end
					if target then
						-- teleport ulang hanya kalau terlempar jauh
						if (hrp.Position-genPos(target)).Magnitude>30 and os.clock()-lastTp>1.5 then
							tpTo(target)
							lastTp=os.clock()
						end
						if repair(target) then
							noPromptSince=nil
						else
							noPromptSince=noPromptSince or os.clock()
							-- pindah hanya kalau persen tidak terbaca dan prompt hilang lama
							if readPct(target)==nil and os.clock()-noPromptSince>STAY_NO_PROMPT then
								skip[target]=os.clock()+20
								target=nil
								noPromptSince=nil
							end
						end
						if target then
							genStatus="repair "..target.Name.." "..fmtPct((readPct(target)))
						end
					else
						genStatus=(#gens==0) and "generator tidak ketemu" or "semua generator selesai"
					end
				else
					genStatus=target and ("kabur ke "..target.Name) or "siaga kabur"
				end
				if kd then genStatus=genStatus..string.format(" | killer %dm",math.floor(kd)) end
			end
		else
			if target then releaseHold() end
			target=nil
			genStatus="mati"
		end
	end
	task.spawn(function()
		while main.Parent do
			task.wait((rushOn or fleeOn) and 0.15 or 0.5)
			pcall(rushTick)
		end
	end)

	-- =================================================================
	-- ESP GENERATOR / PALET (generator muncul saat terhalang tembok; palet selalu)
	-- =================================================================
	local objHl={}
	local objParams=RaycastParams.new()
	objParams.FilterType=Enum.RaycastFilterType.Exclude
	local function objHidden(m)
		local cam=workspace.CurrentCamera
		if not cam then return false end
		local ign={m}
		if lp.Character then table.insert(ign,lp.Character) end
		objParams.FilterDescendantsInstances=ign
		local origin=cam.CFrame.Position
		local pts={genPos(m)}
		local mp=mainPart(m)
		if mp then pts[#pts+1]=mp.Position end
		for _,pos in ipairs(pts) do
			if not workspace:Raycast(origin,pos-origin,objParams) then return false end
		end
		return true
	end
	local function espTick()
		if not (espGenOn or espPalOn or next(objHl)) then return end
		local want={}
		if espGenOn then for _,g in ipairs(gens) do want[g]="gen" end end
		if espPalOn then for _,p in ipairs(pals) do want[p]="pal" end end
		for m,key in pairs(want) do
			local o=objHl[m]
			if not o or o.key~=key or not o.hl.Parent then
				if o then pcall(function() o.hl:Destroy() end) end
				objHl[m]={key=key,hl=new("Highlight",{
					Adornee=m,FillTransparency=0.6,OutlineTransparency=0,
					DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Enabled=false,
				},espFolder)}
			end
		end
		for m,o in pairs(objHl) do
			if not want[m] or not m.Parent then
				pcall(function() o.hl:Destroy() end)
				objHl[m]=nil
			else
				local col=(o.key=="gen") and PALETTE[colGen.value].c or PALETTE[colPal.value].c
				o.hl.FillColor=col
				o.hl.OutlineColor=col
				o.hl.Enabled=(o.key=="pal") or objHidden(m)
			end
		end
	end
	task.spawn(function()
		while main.Parent do
			task.wait(0.4)
			pcall(espTick)
		end
	end)

	-- =================================================================
	-- PERSEN DI ATAS GENERATOR
	-- =================================================================
	local pctBB={}
	local function pctTick()
		if pctOn then
			for _,g in ipairs(gens) do
				local b=pctBB[g]
				if not b or not b.bb.Parent then
					local part=mainPart(g)
					if part then
						local bb=new("BillboardGui",{
							Adornee=part,Size=UDim2.new(0,70,0,24),
							StudsOffset=Vector3.new(0,4,0),AlwaysOnTop=true,
						},espFolder)
						local lbl=new("TextLabel",{
							BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),
							Font=FONTB,TextSize=18,TextStrokeTransparency=0.3,
							TextColor3=TXT,Text="?%",
						},bb)
						b={bb=bb,lbl=lbl}
						pctBB[g]=b
					end
				end
				if b then
					local pct=readPct(g)
					b.lbl.Text=fmtPct(pct)
					if not pct then
						b.lbl.TextColor3=Color3.fromRGB(200,200,200)
					elseif pct>=99.5 then
						b.lbl.TextColor3=Color3.fromRGB(80,230,100)
					elseif pct>=50 then
						b.lbl.TextColor3=Color3.fromRGB(240,200,60)
					else
						b.lbl.TextColor3=Color3.fromRGB(255,120,80)
					end
				end
			end
		end
		for g,b in pairs(pctBB) do
			if not pctOn or not g.Parent then
				pcall(function() b.bb:Destroy() end)
				pctBB[g]=nil
			end
		end
	end
	task.spawn(function()
		while main.Parent do
			task.wait(0.4)
			pcall(pctTick)
		end
	end)

	-- =================================================================
	-- UPDATE STATUS (hanya saat tab Generator terbuka)
	-- =================================================================
	task.spawn(function()
		while main.Parent do
			task.wait(0.25)
			if Frame.Visible and P.page.Visible then
				pcall(function()
					local src=""
					if gens[1] then
						local _,nm=readPct(gens[1])
						src=nm and ("persen dari: "..nm) or "persen: sumber TIDAK ketemu"
					end
					statusLbl.Text=string.format("SC: %s | tekan: %d\nGEN: %d ketemu, palet %d | %s\n%s",
						lastStatus,pressCount,#gens,#pals,genStatus,src)
				end)
			end
		end
	end)
end)

